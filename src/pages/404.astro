---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found | Linus Ekberg">
  <section class="not-found wrap">
    <h1 class="serif-heading">Page not found</h1>
    <p>That page doesn't exist. <a href="/">Go to the home page</a>.</p>
  </section>
</Base>

<style>
  .not-found {
    display: grid;
    justify-items: center;
    gap: 20px;
    padding-top: 60px;
    font-size: 16px;
  }

  .serif-heading {
    padding-inline: 20px;
  }
</style>
