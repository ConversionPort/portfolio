---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
---

<Base title="Contact | Linus Ekberg" description="Contact Linus Ekberg by e-mail, LinkedIn or GitHub.">
  <section class="contact wrap">
    <div class="details">
      <h1 class="serif-heading">Contact me!</h1>
      <p>Linus Ekberg</p>
      <p>E-mail: <a href="mailto:ekberglinus01@gmail.com">ekberglinus01@gmail.com</a></p>
      <p>Stockholm, Sweden</p>
    </div>
    <ul class="social">
      <li>
        <a href="https://www.linkedin.com/in/linus-ekberg-535097204" aria-label="LinkedIn">
          <Img name="1384014.png" width={70} />
        </a>
      </li>
      <li>
        <a href="https://github.com/KR0SS0" aria-label="GitHub">
          <Img name="github-mark-edited.png" width={88} />
        </a>
      </li>
    </ul>
  </section>
</Base>

<style>
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 494px) auto;
    align-items: start;
    padding: 31px 0 0 81px;
  }

  .serif-heading {
    display: inline-block;
    margin-bottom: 6px;
    padding-right: 15px;
    color: #000;
    text-align: left;
  }

  .details p {
    font-size: 20px;
    line-height: 33.4px;
    color: #000;
  }

  .details a {
    color: inherit;
    text-decoration: none;
  }

  .details a:hover {
    text-decoration: underline;
  }

  .social {
    display: flex;
    align-items: center;
    gap: 55px;
    margin-top: 18px;
    padding: 0;
    list-style: none;
  }

  .social a {
    display: block;
    transition: opacity 0.15s;
  }

  .social a:hover {
    opacity: 0.75;
  }

  @media (max-width: 760px) {
    .contact {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
      padding-left: 0;
    }

    .details p {
      font-size: 18px;
    }
  }
</style>
