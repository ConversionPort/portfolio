import Figure from '../components/Figure.astro';
import YouTube from '../components/YouTube.astro';
import Steam from '../components/Steam.astro';
import PdfLink from '../components/PdfLink.astro';

const toc = [
  ['overview', 'Overview'],
  ['how-to-play', 'How To Play'],
  ['first-playable', 'First-Playable'],
  ['prototype-mechanics', 'Prototype Mechanics'],
  ['alpha', 'Alpha'],
  ['beta', 'Beta & Code Release'],
  ['steam-release', 'Steam Release'],
  ['tutorial', 'Steam Release: Tutorial'],
  ['level-design', 'Level Design'],
  ['programming', 'Programming'],
];

const recipesPdf = '/files/delivery-manager-ui-recipes-overhaul.pdf';
const drive = (id: string) => `https://drive.google.com/file/d/${id}/view?usp=sharing`;
const watch = {
