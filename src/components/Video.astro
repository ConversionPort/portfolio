---
// One of the videos that used to be hosted by Wix, with a poster frame.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import media from '../data/media.json';

const posters = import.meta.glob<{ default: ImageMetadata }>('../assets/media/posters/*.jpg', { eager: true });

interface Props {
  name: string;
  /** Display width in CSS pixels on a desktop screen. */
  width?: number;
  label?: string;
  class?: string;
}

const { name, width, label, class: className } = Astro.props;
const video = (media.videos as Record<string, { src: string; poster: string; width: number; height: number }>)[name];
if (!video) throw new Error(`Video not found in media.json: ${name}`);
const display = Math.min(width ?? video.width, video.width);
const poster = await getImage({ src: posters[`../assets/media/posters/${video.poster}`].default, width: Math.min(display * 2, video.width), format: 'webp' });
---

<video
  class:list={['media-video', className]}
  src={video.src}
  poster={poster.src}
  width={display}
  height={Math.round((display * video.height) / video.width)}
  controls
  playsinline
  preload="none"
  aria-label={label}
></video>
